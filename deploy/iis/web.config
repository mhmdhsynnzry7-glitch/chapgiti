<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <webSocket enabled="true" />
    <directoryBrowse enabled="false" />
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="16777216" />
      </requestFiltering>
    </security>
    <httpProtocol><customHeaders>
      <remove name="X-Powered-By" />
      <add name="Strict-Transport-Security" value="max-age=31536000" />
    </customHeaders></httpProtocol>
    <rewrite>
      <rules>
        <rule name="Canonical HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^__HOST_REGEX__$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://__PUBLIC_HOST__/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Giti SignalR" stopProcessing="true">
          <match url="^api/realtime/(customer|admin)/(notifications|support)(?:/negotiate)?/?$" />
          <serverVariables>
            <set name="HTTP_X_NAGHSH_CLIENT_IP" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:__BACKEND_PORT__/{R:0}" appendQueryString="true" />
        </rule>
        <rule name="Giti Node" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_NAGHSH_CLIENT_IP" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:__PORT__/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
