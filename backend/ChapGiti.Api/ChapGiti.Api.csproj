<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ChapGiti.Application/ChapGiti.Application.csproj" />
    <ProjectReference Include="../ChapGiti.Infrastructure/ChapGiti.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../ChapGiti.Infrastructure/Persistence/Migrations/*.sql" Link="Data/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../ChapGiti.Infrastructure/Content/defaults.json" Link="Data/defaults.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
