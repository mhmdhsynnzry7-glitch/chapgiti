# Copy to a private environment file on the intended machine.
SITE_URL=http://127.0.0.1:3000
PORT=3000
DOTNET_API_URL=http://127.0.0.1:5100
# Windows integrated authentication on the local Development instance. Set your own server configuration.
SQLSERVER_CONNECTION_STRING="Server=.;Database=ChapGiti;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
DATA_DIR=./data
TRUST_IIS_PROXY=false
ALLOW_HTTP=true
INDEXING_ENABLED=false

SMS_ENABLED=false
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
MELIPAYAMAK_BODY_ID=
OTP_ENABLED=false
OTP_VERIFICATION_ENABLED=true
MELIPAYAMAK_CONSOLE_API_KEY=
OTP_CODE_LENGTH=4
OTP_LIFETIME_SECONDS=120
